# Copy to .env (gitignored) and fill in. NEVER commit real values.

# Only the subdomain name, without protocol and without .livespace.io
LIVESPACE_SUBDOMAIN=

# Livespace public API v2 service key (ls_...). REQUIRED from 0.2.0; for the
# v1 API alone use livespace-crm-mcp@0.1. The key belongs to an integration
# user: the server sees every active record that user sees and writes as the
# integration, not as you. Give it only the read scopes for a read-only
# server; a write server adds write scopes, never delete scopes and never
# crm:sales-process:write.
LIVESPACE_API_V2_KEY=

# Optional v1 (signed-session) credentials, both or neither: Account settings
# -> API -> Users. They serve only what API v2 does not publish yet (record
# wall and system feed, deal probability, stage reach).
LIVESPACE_API_KEY=
LIVESPACE_API_SECRET=

# Optional: the e-mail of the Livespace user you act for. "My deals" and
# write attribution need it; the v2 key alone has no human identity.
LIVESPACE_ACTING_USER_EMAIL=

# Daily API v2 requests left untouched for the account's other integrations
# (the daily limit is shared by every key of the account). Integer 0-1000000,
# default 5000; 0 turns the guard off.
LIVESPACE_V2_DAILY_RESERVE=5000

# --- Server ---
MCP_PORT=3020

# Bind address. Keep 127.0.0.1 for local use.
# If you change this to a non-loopback address, MCP_AUTH_TOKEN,
# MCP_ALLOWED_HOSTS and LIVESPACE_V2_SHARED_ACCESS become REQUIRED and the
# server will refuse to start without them (fail-closed).
MCP_BIND_HOST=127.0.0.1

# Required for a non-loopback bind; the only accepted value is
# "acknowledged". Every client of a shared server sees what the API v2
# integration user sees.
LIVESPACE_V2_SHARED_ACCESS=

# Bearer token required on /mcp. Mandatory for writes and every non-loopback
# bind. Also recommended for read-only localhost use.
MCP_AUTH_TOKEN=

# Safe default: write tools do not exist unless this is exactly "true".
LIVESPACE_MCP_ENABLE_WRITES=false

# Emergency kill-switch. "true" disables writes even when enabled above.
LIVESPACE_MCP_READ_ONLY=false

# HMAC secret (at least 32 bytes) that signs write confirmations. REQUIRED when
# writes are enabled. Read-only servers do not use confirmation state.
MCP_REQUEST_STATE_KEY=

# Unsafe compatibility escape hatch for MCP clients without form elicitation.
# Leave false. When true, confirm:true can execute without signed human state.
MCP_ALLOW_UNBOUND_WRITE_CONFIRMATION=false

# Required when MCP_BIND_HOST is not loopback: hostnames clients use to reach
# this server (Host-header allowlist, DNS-rebinding protection).
MCP_ALLOWED_HOSTS=

# Optional extra browser origins allowed to call /mcp (hostnames only).
MCP_ALLOWED_ORIGIN_HOSTNAMES=

# Rate limiting (per bearer principal): sustained requests per minute + burst.
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_RATE_LIMIT_BURST=30

# Overload protection: max in-flight MCP requests and max queued requests.
# Excess requests get 429 with a Retry-After header.
MCP_MAX_CONCURRENT_REQUESTS=8
MCP_MAX_QUEUED_REQUESTS=16

# Absolute budget for admission queueing plus request-body upload. It does not
# limit tool execution. Allowed range: 1-60000 ms.
MCP_REQUEST_INGRESS_TIMEOUT_MS=10000

# Absolute budget for tool execution after body upload. Allowed range:
# 1-180000 ms. Writes preserve unknown-outcome reporting when this aborts them.
# The HTTP idle timeout is derived from this and the ingress budget.
MCP_REQUEST_EXECUTION_TIMEOUT_MS=90000
