# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Credentials are per Livespace user: Account settings -> API -> Users.
# All API calls run with that user's permissions.

# Only the subdomain name, without protocol and without .livespace.io
LIVESPACE_SUBDOMAIN=
LIVESPACE_API_KEY=
LIVESPACE_API_SECRET=

# --- Server ---
MCP_PORT=3020

# Bind address. Keep 127.0.0.1 for local use.
# If you change this to a non-loopback address, MCP_AUTH_TOKEN becomes
# REQUIRED and the server will refuse to start without it (fail-closed).
MCP_BIND_HOST=127.0.0.1

# Bearer token required on /mcp. Optional on localhost, mandatory otherwise.
MCP_AUTH_TOKEN=

# Global kill-switch: "true" disables every write tool (read-only mode).
LIVESPACE_MCP_READ_ONLY=false

# HMAC secret (at least 32 bytes) that signs write confirmations. REQUIRED as
# soon as MCP_AUTH_TOKEN is set or MCP_BIND_HOST is not loopback - the server
# refuses to start without it. On loopback without it, confirmations are signed
# with a random per-process key that stops verifying after a restart.
MCP_REQUEST_STATE_KEY=

# Required when MCP_BIND_HOST is not loopback: hostnames clients use to reach
# this server (Host-header allowlist, DNS-rebinding protection).
MCP_ALLOWED_HOSTS=

# Optional extra browser origins allowed to call /mcp (hostnames only).
MCP_ALLOWED_ORIGIN_HOSTNAMES=

# Rate limiting (per bearer principal): sustained requests per minute + burst.
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_RATE_LIMIT_BURST=30

# Overload protection: max in-flight MCP requests and max queued requests.
# Excess requests get 429 with a Retry-After header.
MCP_MAX_CONCURRENT_REQUESTS=8
MCP_MAX_QUEUED_REQUESTS=16

# Absolute budget for admission queueing plus request-body upload. It does not
# limit tool execution. Allowed range: 1-60000 ms.
MCP_REQUEST_INGRESS_TIMEOUT_MS=10000
